/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# Both forms: the bare `env.local` (no leading dot) is a real file in this
# repo and was NOT matched by `.env*.local`, so it got committed once.
.env*.local
.env
env.local
env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode
.idea
*.swp
*.swo

# Large model files
tools/piper/voices/*.onnx
*.onnx

# OS
Thumbs.db

# Large model files and storage
tools/piper/voices/*.onnx
*.onnx
anythingllm/qdrant_storage/
anythingllm/storage/
*.dat
*.info

# Migration backups contain production user data — never commit
_migration_backups/

# Documentation (keep only README.md and the deploy runbook)
*.md
!README.md
# DEPLOY.md is operational, not prose: env vars, webhook events and the
# post-deploy checks. It has to travel with the repo or a fresh clone cannot
# be deployed without asking someone.
!docs/DEPLOY.md

# Build artifacts
.next/
tsc_output.txt
*.tsbuildinfo
supabase/.temp/
